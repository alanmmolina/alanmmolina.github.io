{
  "name": "custom-light",
  "displayName": "Custom Light",
  "type": "light",
  "colors": {
    "editor.foreground": "#2B2B2B",
    "editor.background": "#FAF8F8"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#2B2B2B",
        "background": "#FAF8F8"
      }
    },
    {
      "name": "Comment",
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": { "foreground": "#7A828C" }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.unquoted",
        "string.interpolated",
        "punctuation.definition.string"
      ],
      "settings": { "foreground": "#3D8B2F" }
    },
    {
      "name": "String escape",
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "#3D8B2F" }
    },
    {
      "name": "String regexp",
      "scope": [
        "string.regexp",
        "constant.character.character-class.regexp",
        "constant.other.character-class.set.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp",
        "keyword.control.anchor.regexp",
        "punctuation.definition.character-class.regexp",
        "punctuation.definition.string.regexp"
      ],
      "settings": { "foreground": "#3D8B2F" }
    },
    {
      "name": "String special",
      "scope": ["constant.other.placeholder", "constant.other.color", "string.special"],
      "settings": { "foreground": "#3D8B2F" }
    },
    {
      "name": "String symbol",
      "scope": ["constant.other.symbol", "string.special.symbol"],
      "settings": { "foreground": "#3D8B2F" }
    },
    {
      "name": "Docstring",
      "scope": [
        "string.quoted.docstring",
        "comment.block.documentation",
        "string.quoted.docstring punctuation.definition.string",
        "comment.block.documentation punctuation.definition.string"
      ],
      "settings": { "foreground": "#7A828C" }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#0A0A0A" }
    },
    {
      "name": "Boolean and null",
      "scope": ["constant.language", "constant.language.boolean", "constant.language.null"],
      "settings": { "foreground": "#0A0A0A" }
    },
    {
      "name": "Constant",
      "scope": ["constant", "entity.name.constant", "variable.other.constant", "support.constant"],
      "settings": { "foreground": "#1565C0" }
    },
    {
      "name": "Enum and variant",
      "scope": ["entity.name.type.enum", "variable.other.enummember", "constant.other.enum"],
      "settings": { "foreground": "#1565C0" }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "keyword.control", "keyword.other"],
      "settings": { "foreground": "#D14D4D" }
    },
    {
      "name": "Storage",
      "scope": ["storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#D14D4D" }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#D14D4D" }
    },
    {
      "name": "Function",
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#4F46E5" }
    },
    {
      "name": "Type",
      "scope": ["entity.name.type", "support.type", "support.class"],
      "settings": { "foreground": "#4F46E5" }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#4F46E5" }
    },
    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "punctuation.definition.preprocessor",
        "punctuation.definition.directive"
      ],
      "settings": { "foreground": "#4F46E5" }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#9B4FD4" }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "variable.parameter.function",
        "variable.parameter.function.language"
      ],
      "settings": { "foreground": "#B85C00" }
    },
    {
      "name": "Special variable",
      "scope": ["variable.language", "variable.other.special", "variable.special"],
      "settings": { "foreground": "#B85C00" }
    },
    {
      "name": "Label",
      "scope": ["entity.name.label"],
      "settings": { "foreground": "#B85C00" }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "support.type.property-name",
        "meta.object-literal.key",
        "meta.property-name",
        "entity.name.tag.yaml",
        "entity.name.tag.yml"
      ],
      "settings": { "foreground": "#1565C0" }
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.other", "variable.other.readwrite", "support.variable"],
      "settings": { "foreground": "#2B2B2B" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation"],
      "settings": { "foreground": "#5C6370" }
    },
    {
      "name": "Bracket",
      "scope": [
        "meta.brace.round",
        "meta.brace.square",
        "meta.brace.curly",
        "punctuation.definition.block",
        "punctuation.section.block",
        "punctuation.section.group",
        "punctuation.definition.parameters",
        "punctuation.definition.arguments",
        "punctuation.definition.list",
        "punctuation.definition.dict",
        "punctuation.definition.array"
      ],
      "settings": { "foreground": "#A67C00" }
    },
    {
      "name": "Special punctuation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "punctuation.definition.interpolation"
      ],
      "settings": { "foreground": "#4F46E5" }
    },
    {
      "name": "List marker",
      "scope": ["punctuation.definition.list.begin.markdown", "punctuation.definition.list_item"],
      "settings": { "foreground": "#D14D4D" }
    },
    {
      "name": "Heading",
      "scope": ["markup.heading", "punctuation.definition.heading", "entity.name.section"],
      "settings": { "foreground": "#D14D4D", "fontStyle": "bold" }
    },
    {
      "name": "Link text",
      "scope": ["string.other.link", "string.other.reference", "constant.other.reference.link"],
      "settings": { "foreground": "#1565C0" }
    },
    {
      "name": "Link URI",
      "scope": [
        "markup.underline.link",
        "string.other.link.description",
        "string.other.link.title"
      ],
      "settings": { "foreground": "#4F46E5" }
    },
    {
      "name": "Emphasis",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#1565C0", "fontStyle": "italic" }
    },
    {
      "name": "Strong emphasis",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#D14D4D", "fontStyle": "bold" }
    },
    {
      "name": "Inline raw",
      "scope": ["markup.inline.raw", "string.unquoted.markdown", "markup.raw.inline"],
      "settings": { "foreground": "#3D8B2F" }
    },
    {
      "name": "Insertion",
      "scope": ["markup.inserted", "punctuation.definition.inserted"],
      "settings": { "foreground": "#3D8B2F" }
    },
    {
      "name": "Deletion",
      "scope": ["markup.deleted", "punctuation.definition.deleted"],
      "settings": { "foreground": "#D14D4D" }
    },
    {
      "name": "Change",
      "scope": ["markup.changed", "punctuation.definition.changed"],
      "settings": { "foreground": "#B85C00" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
      "settings": { "foreground": "#D14D4D" }
    }
  ]
}
